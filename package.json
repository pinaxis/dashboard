{
  "name": "pinaxis-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:public": "tsc --noEmit && node scripts/build-graph.mjs && node scripts/assert-public-safe.mjs && vite build",
    "build:private": "tsc --noEmit && node scripts/build-graph.mjs private && vite build --mode private && node scripts/assert-private-scoped.mjs",
    "graph": "node scripts/build-graph.mjs",
    "test": "node scripts/make-fixture.mjs && node --test \"test/**/*.test.mjs\"",
    "fixture": "node scripts/make-fixture.mjs",
    "demo": "node scripts/make-demo-graph.mjs",
    "check:safe": "node scripts/assert-public-safe.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:scoped": "node scripts/assert-private-scoped.mjs",
    "deploy:public": "npm run build:public && wrangler deploy",
    "deploy:private": "npm run build:private && wrangler deploy --config wrangler.private.toml"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sigma": "^3.0.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
